# ==============================================================================
# SMARTCITY360 - ENVIRONMENT CONFIGURATION (SAMPLE)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SmartCity360"
API_V1_STR="/api/v1"
SECRET_KEY="development-insecure-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database Configuration (PostgreSQL / SQLite fallback for local test)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartcity_admin
POSTGRES_PASSWORD=smartcity_secure_pass
POSTGRES_DB=smartcity360_db
DATABASE_URL="postgresql+asyncpg://smartcity_admin:smartcity_secure_pass@localhost:5432/smartcity360_db"
DATABASE_URL_SYNC="postgresql+psycopg2://smartcity_admin:smartcity_secure_pass@localhost:5432/smartcity360_db"

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# GIS & Map Configuration (OpenStreetMap / Leaflet - Zero Paid API Key Requirement)
MAP_DEFAULT_LATITUDE=12.9716
MAP_DEFAULT_LONGITUDE=77.5946
MAP_DEFAULT_ZOOM=12
TILE_SERVER_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# Storage & Evidence Uploads
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS="jpg,jpeg,png,webp,pdf,doc,docx"

# Mock Payment Gateway Provider (Zero External Secret Key Dependency)
MOCK_PAYMENT_GATEWAY_ENABLED=true
MOCK_PAYMENT_SUCCESS_RATE=0.98

# Logging & Telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_AUDIT_LOGGING=true
